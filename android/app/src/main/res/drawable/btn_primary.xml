<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#25B98F"
                android:endColor="#2F8FE0" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#332FD4A7" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2FD4A7"
                android:endColor="#48A8FF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
