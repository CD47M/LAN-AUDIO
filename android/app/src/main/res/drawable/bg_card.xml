<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base tint keeps text readable on older devices where gradients
         above the blur are rendered less strongly -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D0F151E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2BFFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
